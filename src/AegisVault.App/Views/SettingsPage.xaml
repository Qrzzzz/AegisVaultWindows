<Page x:Class="AegisVault.App.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="24" RowDefinitions="*,Auto" RowSpacing="20" MaxWidth="928" HorizontalAlignment="Stretch">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="SettingsScroll">
    <StackPanel Spacing="24" Padding="0,0,12,4">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding L[settings]}" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="{Binding L[settings_description]}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
      <UserControl IsEnabled="{Binding IsIdle}"><StackPanel Spacing="16">
        <ComboBox Header="{Binding L[language]}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.AutomationId="Language">
          <ComboBoxItem Content="简体中文" /><ComboBoxItem Content="English" />
        </ComboBox>
        <ComboBox Header="{Binding L[theme]}" ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
            MinWidth="180" AutomationProperties.AutomationId="Theme" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Header="{Binding L[output_folder]}" Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              PlaceholderText="{Binding L[same_folder]}" AutomationProperties.AutomationId="SettingsOutputFolder" />
          <Button Grid.Column="1" Click="PickFolder" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding L[choose_folder]}"
              AutomationProperties.Name="{Binding L[choose_folder]}" AutomationProperties.AutomationId="SettingsPickFolder"><SymbolIcon Symbol="Folder" /></Button>
        </Grid>
        <CheckBox Content="{Binding L[remember_recent]}" IsChecked="{Binding RememberRecent, Mode=TwoWay}" AutomationProperties.AutomationId="RememberRecent" />
        <Expander Header="{Binding L[recent_files]}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RecentHistory">
          <StackPanel Spacing="12">
            <ItemsControl ItemsSource="{Binding RecentFiles}"><ItemsControl.ItemTemplate><DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding L[no_recent_files]}" Visibility="{Binding EmptyRecentVisibility}" TextWrapping="Wrap" />
            <Button Content="{Binding L[clear_recent]}" Click="ClearRecent" IsEnabled="{Binding HasRecentFiles}" AutomationProperties.AutomationId="ClearRecent" />
          </StackPanel>
        </Expander>
        <Expander Header="{Binding L[advanced]}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="12">
            <CheckBox Content="{Binding L[overwrite]}" IsChecked="{Binding Overwrite, Mode=TwoWay}" AutomationProperties.AutomationId="Overwrite" />
            <TextBlock Text="{Binding L[overwrite_warning]}" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </StackPanel></UserControl>
      <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="{Binding L[about]}" TextWrapping="Wrap" />
      <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/Qrzzzz/AegisVaultWindows" />
      <TextBlock Text="MIT License" />
    </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="0,16,0,0">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding DraftStatus}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            AutomationProperties.AutomationId="SettingsDraftStatus" AutomationProperties.LiveSetting="Polite" />
        <InfoBar IsOpen="{Binding HasStatus}" Severity="{Binding Severity}" Message="{Binding Status}" IsClosable="False"
            AutomationProperties.AutomationId="SettingsStatus" AutomationProperties.LiveSetting="Polite" />
        <UserControl IsEnabled="{Binding IsIdle}"><Grid ColumnDefinitions="Auto,*,Auto">
          <Button Content="{Binding L[save_settings]}" Style="{StaticResource AccentButtonStyle}" Click="Save"
              IsEnabled="{Binding HasChanges}" AutomationProperties.AutomationId="SaveSettings" />
          <Button Grid.Column="2" Content="{Binding L[discard]}" Click="Discard" IsEnabled="{Binding HasChanges}" AutomationProperties.AutomationId="DiscardSettings" />
        </Grid></UserControl>
      </StackPanel>
    </Border>
  </Grid>
</Page>
