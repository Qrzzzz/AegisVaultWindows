<Page x:Class="AegisVault.App.Views.TextPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:AegisVault.App.Views">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24" Spacing="20" MaxWidth="880" HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding L[text_description]}" TextWrapping="Wrap" />
      <views:WorkflowControl x:Name="Workflow" />
    </StackPanel>
  </ScrollViewer>
</Page>
