<Page x:Class="AegisVault.App.Views.Base64Page" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:AegisVault.App.Views">
  <Grid Padding="24" MaxWidth="928" HorizontalAlignment="Stretch">
    <views:WorkflowControl x:Name="Workflow"><views:WorkflowControl.Header>
    <StackPanel Spacing="12">
      <TextBlock Text="Base64" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding L[base64_warning]}" />
      <ComboBox x:Name="InputKind" Header="{Binding L[input_kind]}" SelectedIndex="0" SelectionChanged="ChangeKind" MinWidth="180" AutomationProperties.AutomationId="InputKind">
        <ComboBoxItem x:Name="TextKind" /><ComboBoxItem x:Name="FileKind" />
      </ComboBox>
    </StackPanel>
    </views:WorkflowControl.Header></views:WorkflowControl>
  </Grid>
</Page>
