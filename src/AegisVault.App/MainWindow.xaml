<Window x:Class="AegisVault.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" RowDefinitions="Auto,*" AllowDrop="True" DragOver="DragFilesOver" Drop="DropFiles">
    <TitleBar x:Name="AppTitleBar" Title="AegisVault" Subtitle="{Binding AppVersion}" />
    <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Auto" OpenPaneLength="220" AlwaysShowHeader="False" IsSettingsVisible="False"
        SelectionChanged="Navigate" DisplayModeChanged="DisplayModeChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="{Binding L[text]}" Tag="text" AutomationProperties.AutomationId="NavText"><NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="{Binding L[file]}" Tag="file" AutomationProperties.AutomationId="NavFile"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Base64" Tag="base64" AutomationProperties.AutomationId="NavBase64"><NavigationViewItem.Icon><SymbolIcon Symbol="Switch" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="{Binding L[settings]}" Tag="settings" AutomationProperties.AutomationId="NavSettings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid x:Name="PageHost" RowDefinitions="Auto,*">
        <InfoBar x:Name="StartupError" Severity="Error" IsClosable="False" />
        <Frame x:Name="ContentFrame" Grid.Row="1" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
